<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Tervia</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Tervia.App</RootNamespace>
    <Version>0.2.0-alpha</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <TerviaHomeAndroidVariant Condition="'$(TerviaHomeAndroidVariant)' == ''">debug</TerviaHomeAndroidVariant>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Tervia.Home.Android\app\build\outputs\apk\$(TerviaHomeAndroidVariant)\app-$(TerviaHomeAndroidVariant).apk"
             Condition="Exists('..\Tervia.Home.Android\app\build\outputs\apk\$(TerviaHomeAndroidVariant)\app-$(TerviaHomeAndroidVariant).apk')"
             Link="Tervia.Home.Android.apk"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tervia.Application\Tervia.Application.csproj" />
    <ProjectReference Include="..\Tervia.Core\Tervia.Core.csproj" />
    <ProjectReference Include="..\Tervia.Capabilities\Tervia.Capabilities.csproj" />
    <ProjectReference Include="..\Tervia.Discovery\Tervia.Discovery.csproj" />
    <ProjectReference Include="..\Tervia.Infrastructure\Tervia.Infrastructure.csproj" />
    <ProjectReference Include="..\Tervia.Safety\Tervia.Safety.csproj" />
    <ProjectReference Include="..\Platforms\Tervia.Platforms.AndroidTV\Tervia.Platforms.AndroidTV.csproj" />
  </ItemGroup>
</Project>
