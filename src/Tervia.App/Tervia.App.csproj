<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Tervia</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Tervia.App</RootNamespace>
    <Version>0.1.0-alpha</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tervia.Application\Tervia.Application.csproj" />
    <ProjectReference Include="..\Tervia.Core\Tervia.Core.csproj" />
    <ProjectReference Include="..\Tervia.Capabilities\Tervia.Capabilities.csproj" />
    <ProjectReference Include="..\Tervia.Discovery\Tervia.Discovery.csproj" />
    <ProjectReference Include="..\Tervia.Infrastructure\Tervia.Infrastructure.csproj" />
  </ItemGroup>
</Project>
