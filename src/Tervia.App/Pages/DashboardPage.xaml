<Page
    x:Class="Tervia.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24" Spacing="18" MaxWidth="1240" HorizontalAlignment="Center">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Inicio" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Tu espacio para descubrir y organizar televisores inteligentes." Opacity="0.76" />
                </StackPanel>
                <Border Grid.Column="1" Padding="11,7" CornerRadius="18"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="#24C4E8" VerticalAlignment="Center" />
                        <TextBlock Text="SOLO EN TU RED LOCAL" FontSize="10" CharacterSpacing="80" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="20" Padding="28" MinHeight="224">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#081A3A" Offset="0" />
                        <GradientStop Color="#123E85" Offset="0.58" />
                        <GradientStop Color="#087DAD" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="12" VerticalAlignment="Center" MaxWidth="780">
                        <TextBlock Text="TERVIA  ·  GESTIÓN LOCAL DE SMART TV" FontSize="10"
                                   CharacterSpacing="100" Foreground="#9EEFFF" />
                        <TextBlock Text="Tus televisores,&#xA;en un solo lugar." FontSize="36"
                                   FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="Encuentra TVs en tu red, revisa cada resultado y guarda perfiles en este equipo. Sin cuenta, nube ni telemetría."
                                   Foreground="#E2EDFF" TextWrapping="Wrap" MaxWidth="680" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button Content="Buscar televisores" Click="OnDiscoveryClick"
                                    Background="#25D5F2" Foreground="#07172F" BorderThickness="0"
                                    Padding="18,10" FontWeight="SemiBold"
                                    AutomationProperties.Name="Buscar televisores en la red local" />
                            <Button Content="Añadir por IP" Click="OnManualAddClick"
                                    Background="#183A6A" Foreground="White" BorderBrush="#668BBF"
                                    BorderThickness="1" Padding="18,10" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="188" Height="168" VerticalAlignment="Center">
                        <Ellipse Width="164" Height="164" Fill="#24BCE8" Opacity="0.12" />
                        <Image x:Name="HeroLogo" Source="ms-appx:///Assets/logo-tervia-white.png" Width="144" Height="144"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.Name="Logotipo Tervia" />
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="17,15" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="5">
                        <TextBlock Text="TELEVISORES GUARDADOS" FontSize="10" CharacterSpacing="70" Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.DeviceCount, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="Perfiles locales" FontSize="12" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="17,15" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="5">
                        <TextBlock Text="EN LÍNEA" FontSize="10" CharacterSpacing="70" Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.OnlineCount, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="Según el último estado guardado" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="17,15" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="5">
                        <TextBlock Text="FUNCIONES COMPROBADAS" FontSize="10" CharacterSpacing="70" Opacity="0.72" />
                        <TextBlock Text="{x:Bind ViewModel.VerifiedCapabilitiesInLibrary, Mode=OneWay}" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="Solo con evidencia registrada" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="20" CornerRadius="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Mis televisores" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Una biblioteca guardada en este PC." Opacity="0.72" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ver biblioteca" Click="OnDevicesClick" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="9"
                                    Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="Todavía no has añadido una TV" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Empieza con una búsqueda local o introduce la dirección IP que aparece en los ajustes de red del televisor. Revisar un resultado nunca inicia una conexión."
                                       TextWrapping="Wrap" Opacity="0.78" />
                            <Button Content="Empezar a descubrir" Click="OnDiscoveryClick" HorizontalAlignment="Left"
                                    Background="#25D5F2" Foreground="#07172F" BorderThickness="0"
                                    Padding="16,9" FontWeight="SemiBold" />
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MaxHeight="252" SelectionMode="None" IsItemClickEnabled="False"
                                  AutomationProperties.Name="Televisores guardados">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="7,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="9" Background="#142C53">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#49D8F2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding NetworkAddress}" FontFamily="Consolas" FontSize="12" Opacity="0.72" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Platform}" FontSize="12" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.72" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="20" CornerRadius="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="13">
                        <TextBlock Text="Empieza en tres pasos" FontSize="20" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#15345E">
                                <TextBlock Text="1" Foreground="#77E7F7" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Encuentra" FontWeight="SemiBold" />
                                <TextBlock Text="Busca anuncios de Smart TVs en tu red." FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#15345E">
                                <TextBlock Text="2" Foreground="#77E7F7" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Revisa" FontWeight="SemiBold" />
                                <TextBlock Text="Confirma que sea un televisor físico." FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#15345E">
                                <TextBlock Text="3" Foreground="#77E7F7" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Organiza" FontWeight="SemiBold" />
                                <TextBlock Text="Guarda su perfil local y consulta lo que se ha verificado." FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,4,0,0" Padding="12" CornerRadius="9"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                          FontSize="16" Foreground="#49D8F2" />
                                <TextBlock Text="Sin cuentas, nube ni telemetría." TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="Cómo protegemos tus datos" Click="OnPrivacyClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <controls:InfoBar IsOpen="{x:Bind ViewModel.HasLibraryError, Mode=OneWay}"
                              Severity="Error" Title="Biblioteca local"
                              Message="{x:Bind ViewModel.LibraryError, Mode=OneWay}" />
            <TextBlock Text="Las pistas de fabricante y plataforma no se consideran verificadas. Tervia no inicia emparejamientos ni controles automáticamente."
                       FontSize="12" TextWrapping="Wrap" Opacity="0.66" Margin="0,0,0,8" />
        </StackPanel>
    </ScrollViewer>
</Page>
