<Page
    x:Class="Tervia.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Tervia.App.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="26" Spacing="18" MaxWidth="1180">
            <StackPanel Spacing="4">
                <TextBlock Text="Inicio de TV" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Diseña la pantalla que aparece al pulsar Inicio en una TV Android compatible."
                           FontSize="14" Opacity="0.76" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error" Title="No se completó la operación"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <Border Padding="20" CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PERSONALIZA TU INICIO" FontSize="11" CharacterSpacing="90"
                                       Foreground="#49D8F2" FontWeight="SemiBold" />
                            <TextBlock Text="Tu selección se guarda localmente para cada TV." FontSize="13" Opacity="0.76"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="TitleInput" Header="Título" MaxLength="42"
                                 Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
                                 PlaceholderText="Mi televisión" />
                        <TextBox x:Name="SubtitleInput" Header="Subtítulo" MaxLength="88"
                                 Text="{x:Bind ViewModel.Subtitle, Mode=TwoWay}"
                                 PlaceholderText="Todo tu entretenimiento, en un mismo lugar." />
                        <ComboBox x:Name="ThemeSelector" Header="Color de acento"
                                  SelectedIndex="0" SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="Océano" Tag="ocean" />
                            <ComboBoxItem Content="Violeta" Tag="violet" />
                            <ComboBoxItem Content="Atardecer" Tag="sunset" />
                            <ComboBoxItem Content="Bosque" Tag="forest" />
                        </ComboBox>
                        <ToggleSwitch Header="Mostrar reloj" IsOn="{x:Bind ViewModel.ShowClock, Mode=TwoWay}"
                                      OnContent="Sí" OffContent="No" Toggled="OnClockToggled" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="VISTA PREVIA" FontSize="11" CharacterSpacing="90" Opacity="0.72"
                                   FontWeight="SemiBold" />
                        <Border x:Name="PreviewAccentBorder" Padding="20" CornerRadius="14" Background="#071A2D"
                                BorderBrush="#284969" BorderThickness="1" MinHeight="230">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Image Source="ms-appx:///Assets/logo-tervia-white.png" Width="28" Height="28"
                                           Stretch="Uniform" />
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="TERVIA HOME" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="TU TELEVISOR, A TU MANERA" FontSize="8" Opacity="0.72" />
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewClock" Text="12:45" HorizontalAlignment="Right" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Opacity="0.8" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="PreviewEyebrow" Text="UN INICIO MÁS TUYO" FontSize="9" Foreground="#49D8F2"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="24"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="12"
                                               Opacity="0.8" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="112" Height="60" CornerRadius="10" Background="#132C48">
                                        <TextBlock Text="Aplicación" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="112" Height="60" CornerRadius="10" Background="#132C48">
                                        <TextBlock Text="Aplicación" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="112" Height="60" CornerRadius="10" Background="#132C48">
                                        <TextBlock Text="Aplicación" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="La vista previa es orientativa; las aplicaciones y sus iconos se cargan desde la TV."
                                   FontSize="11" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="20" CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Aplicaciones de la TV" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Elige cuáles se muestran y cuáles aparecen primero en Tervia Home."
                                   FontSize="13" Opacity="0.76" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind ViewModel.Applications, Mode=OneWay}"
                              MaxHeight="360" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeApplicationOption">
                                <Grid Padding="8,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Id}" FontSize="11" Opacity="0.65"
                                                   FontFamily="Consolas" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Mostrar"
                                              IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="2" Content="Fijar primero"
                                              IsChecked="{x:Bind IsPinned, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="12" Background="#132A45">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#49D8F2" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Instalar y abrir en la TV" Click="OnInstallClick"
                        IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}" />
                <Button Content="Guardar cambios en la TV" Click="OnApplyClick"
                        IsEnabled="{x:Bind ViewModel.CanSync, Mode=OneWay}" />
                <Button Content="Elegir launcher en la TV" Click="OnRestoreClick"
                        IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="La pantalla original del fabricante no se desinstala ni se desactiva. Android solicitará en la TV que confirmes Tervia Home como inicio; puedes volver a elegir el original en cualquier momento."
                       FontSize="12" Opacity="0.72" TextWrapping="Wrap" MaxWidth="900" />
        </StackPanel>
    </ScrollViewer>
</Page>
