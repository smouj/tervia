<Page
    x:Class="Tervia.App.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid Margin="32,28" ColumnSpacing="26" MaxWidth="1120" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="5" Margin="0,0,0,16">
            <TextBlock Text="Mis televisores" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Perfiles guardados únicamente en este equipo. Selecciona uno para verlo en el resumen."
                       Style="{StaticResource BodyTextBlockStyle}" Opacity="0.78" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView x:Name="DeviceList" ItemsSource="{x:Bind ViewModel.Shell.Devices, Mode=OneWay}"
                      SelectionMode="Single" SelectionChanged="OnDeviceSelectionChanged"
                      AutomationProperties.Name="Biblioteca de televisores">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,10" Spacing="3">
                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NetworkAddress}" FontFamily="Consolas" FontSize="12" Opacity="0.78" />
                            <TextBlock Text="{Binding Platform}" FontSize="12" Opacity="0.72" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Todavía no hay perfiles guardados. Añade una TV desde Descubrir."
                       Margin="14,18" TextWrapping="Wrap" Opacity="0.72"
                       IsHitTestVisible="False"
                       Visibility="{x:Bind ViewModel.Shell.HasDevices, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>

        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Border Padding="22" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Perfil local" FontSize="11" CharacterSpacing="100" Opacity="0.7" />
                    <TextBlock x:Name="SelectedName" Text="Selecciona un televisor" Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedAddress" FontFamily="Consolas" />
                </StackPanel>
                <TextBlock x:Name="SelectedDetails" TextWrapping="Wrap" Opacity="0.78" />
                <TextBlock Text="Las capacidades permanecen sin verificar hasta ejecutar un flujo de identificación compatible. Guardar un perfil no inicia una conexión."
                           TextWrapping="Wrap" MaxWidth="620" />
                <ContentControl x:Name="RemoteControlPanel">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Control remoto" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Envía una tecla por ADB solo cuando la pulses. La depuración en red debe estar activada y autorizada en la TV."
                                   TextWrapping="Wrap" Opacity="0.78" />
                        <Grid ColumnSpacing="6" RowSpacing="6" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Content="↑" Tag="Up" Click="OnRemoteKeyClick"
                                    AutomationProperties.Name="Arriba" />
                            <Button Grid.Row="1" Grid.Column="0" Content="←" Tag="Left" Click="OnRemoteKeyClick"
                                    AutomationProperties.Name="Izquierda" />
                            <Button Grid.Row="1" Grid.Column="1" Content="OK" Tag="Ok" Click="OnRemoteKeyClick"
                                    AutomationProperties.Name="Aceptar" />
                            <Button Grid.Row="1" Grid.Column="2" Content="→" Tag="Right" Click="OnRemoteKeyClick"
                                    AutomationProperties.Name="Derecha" />
                            <Button Grid.Row="2" Grid.Column="1" Content="↓" Tag="Down" Click="OnRemoteKeyClick"
                                    AutomationProperties.Name="Abajo" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Atrás" Tag="Back" Click="OnRemoteKeyClick" />
                            <Button Content="Inicio" Tag="Home" Click="OnRemoteKeyClick" />
                            <Button Content="Menú" Tag="Menu" Click="OnRemoteKeyClick" />
                        </StackPanel>
                        <ProgressRing x:Name="RemoteProgress" Width="22" Height="22" IsActive="False"
                                      Visibility="Collapsed" HorizontalAlignment="Left" />
                        <TextBlock x:Name="RemoteStatus" TextWrapping="Wrap" Opacity="0.78"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ContentControl>
                <StackPanel Spacing="8">
                    <TextBlock Text="Captura real de pantalla" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Solo Android TV, Google TV y Fire TV con depuración ADB por red ya activada. Al capturar, Tervia se conecta a la dirección guardada; puede aparecer una solicitud de autorización en el televisor. La imagen no se añade a la biblioteca."
                               TextWrapping="Wrap" Opacity="0.78" />
                    <Button x:Name="CaptureButton" Content="Conectar y capturar" Click="OnCaptureClick"
                            HorizontalAlignment="Left" IsEnabled="False" />
                    <ProgressRing x:Name="CaptureProgress" Width="24" Height="24" IsActive="False"
                                  Visibility="Collapsed" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ScreenshotInfo" TextWrapping="Wrap" Opacity="0.72"
                               Visibility="Collapsed" />
                    <Border x:Name="ScreenshotFrame" Padding="8" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            Visibility="Collapsed">
                        <Image x:Name="ScreenshotImage" MaxHeight="360" MaxWidth="660"
                               Stretch="Uniform" AutomationProperties.Name="Captura de la pantalla actual del televisor" />
                    </Border>
                </StackPanel>
                <Button x:Name="RemoveButton" Content="Quitar de la biblioteca" Click="OnRemoveClick"
                        HorizontalAlignment="Left" IsEnabled="False" />
                <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</Page>
