<Page
    x:Class="Tervia.App.Pages.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="22" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Descubrir televisores" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Busca anuncios locales y revisa cada resultado antes de guardarlo. La búsqueda no intenta conectarse a ningún dispositivo."
                           Style="{StaticResource BodyTextBlockStyle}" Opacity="0.78" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Buscar en la red local" Click="OnScanClick" IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}"
                                AutomationProperties.Name="Iniciar búsqueda local de televisores"
                                Background="#25D5F2" Foreground="#07172F" BorderThickness="0"
                                Padding="16,9" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="Cancelar" Click="OnCancelClick" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="460" />
                        </StackPanel>
                    </Grid>

                    <controls:InfoBar IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                                      Severity="Error" Title="Descubrimiento"
                                      Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <TextBlock Text="Candidatos detectados" FontWeight="SemiBold" />
                    <ListView x:Name="CandidateList" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCandidate, Mode=TwoWay}"
                              SelectionMode="Single" MaxHeight="310"
                              AutomationProperties.Name="Candidatos de la red local">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="9,10" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding DiscoveryProtocol}" FontSize="12" />
                                        <TextBlock Text="{Binding PlatformHint}" FontSize="12" Opacity="0.75" />
                                        <TextBlock Text="{Binding ModelHint}" FontSize="12" Opacity="0.75" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Revisar y guardar candidato" Click="OnSaveCandidateClick"
                                IsEnabled="{x:Bind ViewModel.CanAddSelectedCandidate, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="Las pistas de fabricante, plataforma y modelo no se consideran verificadas."
                                   VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.72" />
                    </Grid>

                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasFailures, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Algunos métodos de búsqueda informaron errores" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Failures, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Añadir una dirección manualmente" FontWeight="SemiBold" />
                        <TextBlock Text="Introduce la IP local del televisor. Tervia no resolverá nombres DNS ni probará la conexión al guardarlo."
                                   TextWrapping="Wrap" Opacity="0.76" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualAddressBox" PlaceholderText="192.168.1.50 o dirección IPv6"
                                 AutomationProperties.Name="Dirección IP local del televisor" />
                        <Button Grid.Column="1" Content="Revisar y añadir" Click="OnAddManualClick"
                                Background="#25D5F2" Foreground="#07172F" BorderThickness="0"
                                Padding="16,9" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="5">
                <TextBlock Text="Plataforma seleccionada por el usuario" FontWeight="SemiBold" />
                <TextBlock Text="La clasificación del anuncio se conserva como pista. Solo selecciona una plataforma si la has comprobado en el televisor; las capacidades seguirán sin verificar."
                           TextWrapping="Wrap" Opacity="0.76" />
                <ComboBox x:Name="PlatformPicker" Width="280" HorizontalAlignment="Left"
                          AutomationProperties.Name="Plataforma elegida por el usuario">
                    <ComboBoxItem Content="Sin verificar" Tag="Unknown" IsSelected="True" />
                    <ComboBoxItem Content="Android TV" Tag="AndroidTV" />
                    <ComboBoxItem Content="Google TV" Tag="GoogleTV" />
                    <ComboBoxItem Content="Fire TV" Tag="FireTV" />
                    <ComboBoxItem Content="Samsung Tizen" Tag="Tizen" />
                    <ComboBoxItem Content="LG webOS" Tag="WebOS" />
                    <ComboBoxItem Content="Roku TV" Tag="RokuTV" />
                    <ComboBoxItem Content="VIDAA" Tag="Vidaa" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
